{
  "name": "@ephyra/console",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test": "bun test src",
    "smoke": "env -u LD_LIBRARY_PATH bun scripts/smoke.ts",
    "interactions": "env -u LD_LIBRARY_PATH bun scripts/interactions.ts",
    "voice-interactions": "env -u LD_LIBRARY_PATH bun scripts/voice-interactions.ts",
    "tutor-interactions": "env -u LD_LIBRARY_PATH bun scripts/tutor-interactions.ts",
    "multiplayer": "env -u LD_LIBRARY_PATH bun scripts/multiplayer.ts",
    "screens": "env -u LD_LIBRARY_PATH bun scripts/screens.ts",
    "build:walkthrough": "vite build --config vite.walkthrough.config.ts",
    "build:lab": "vite build --config vite.lab.config.ts",
    "lab:shots": "env -u LD_LIBRARY_PATH bun scripts/lab-shots.ts",
    "loop:accept": "env -u LD_LIBRARY_PATH bun scripts/loop-acceptance.ts",
    "loop:e2e": "env -u LD_LIBRARY_PATH bun --no-env-file scripts/e2e-loop.ts",
    "loop:independent": "env -u LD_LIBRARY_PATH bun --no-env-file scripts/independent-e2e.ts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.32",
    "@assistant-ui/react-markdown": "0.14.24",
    "@ephyra/core": "workspace:*",
    "@ephyra/genui": "workspace:*",
    "@fontsource-variable/anybody": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@json-render/core": "0.22.0",
    "@json-render/react": "0.22.0",
    "qrcode.react": "4.2.0",
    "react": "19",
    "react-dom": "19",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.6",
    "@types/bun": "1.4.4",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsqr": "1.4.0",
    "playwright": "^1.65.0",
    "pngjs": "7.0.0",
    "storybook": "^10.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
