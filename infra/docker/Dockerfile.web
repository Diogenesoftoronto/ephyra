# Ephyra public site (apps/web): landing cuts, journal, pricing, legal, SEO files. Build context: repository root.
# Cut E is the home page; A, B and C stay reachable. Only published cuts are copied; site/_sources and work-in-progress cuts never enter the image.
FROM oven/bun:1.4.4-alpine AS walkthrough-build
WORKDIR /app
COPY package.json tsconfig.base.json ./
COPY infra/docker/server.bun.lock ./bun.lock
COPY packages/ packages/
COPY apps/ apps/
RUN bun install --frozen-lockfile
RUN bun run --filter @ephyra/console build:walkthrough

FROM oven/bun:1.4.4-alpine
WORKDIR /app
COPY tsconfig.base.json ./
COPY apps/web/package.json apps/web/tsconfig.json apps/web/
COPY apps/web/src apps/web/src
COPY apps/web/content apps/web/content
COPY site/assets site/assets
COPY site/e site/e
COPY site/a site/a
COPY site/b site/b
COPY site/c site/c
COPY --from=walkthrough-build /app/apps/console/dist-walkthrough site/e/app
ENV NODE_ENV=production PORT=3000 EPHYRA_SITE_ROOT=/app/site
USER bun
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1:${PORT}/healthz >/dev/null || exit 1
CMD ["bun", "run", "apps/web/src/main.ts"]
